# ============================================================
# Auto Workshop Management POS v1.2.2 — Environment Template
# Copy to .env (or export in your shell / Windows Command Prompt)
# Do NOT commit real secrets or production credentials.
# ============================================================

# Server bind address (default: 127.0.0.1 for local-only security;
# set to 0.0.0.0 to allow LAN computers to connect)
AWP_HOST=127.0.0.1

# Server TCP port (default: 8000; common alternatives: 7290, 1090, 8289)
# Both PORT and AWP_PORT are supported, or pass port to .\run_windows.bat 7290
PORT=8000
AWP_PORT=8000

# Runtime data directory (holds auto_workshop.db, backups/, logs/, uploads/)
# Defaults to <project_root>/data
# AWP_DATA_DIR=./data

# Database connection URL (defaults to SQLite in AWP_DATA_DIR)
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/auto_workshop
# AWP_DATABASE_URL=sqlite:///./data/auto_workshop.db

# Optional custom JWT signing key (min 32 characters recommended).
# If left blank, a random 64-hex secret is generated automatically on first run
# and stored in data/.jwt_secret.
AWP_SECRET_KEY=

# JWT session lifetime in minutes (default: 720 = 12 hours)
AWP_TOKEN_EXPIRE_MINUTES=720

# Currency and timezone
AWP_CURRENCY=PKR
AWP_TIMEZONE=Asia/Karachi

# Allowed CORS origins (comma-separated)
AWP_CORS_ORIGINS=*
